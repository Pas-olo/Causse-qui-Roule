# ——— Secrets : ne jamais les partager, ne jamais les mettre sur GitHub ———

# Bot Telegram (créé avec @BotFather)
BOT_TOKEN=colle_ici_le_token_de_botfather
BOT_USERNAME=NomDuBotSansArobase

# Page d'administration (https://ton-site/admin)
ADMIN_USER=admin
# 10 caractères minimum. Sans mot de passe, la page /admin est désactivée.
ADMIN_PASSWORD=

# Jeton du tunnel Cloudflare (Networking > Tunnels > ton tunnel)
TUNNEL_TOKEN=

# ——— Optionnel ———
PORT=3000

# D'où vient l'IP réelle des visiteurs (limites de requêtes, statistiques) :
#   cloudflare → en-tête CF-Connecting-IP (Cloudflare Tunnel, réglage par défaut avec docker compose)
#   1          → dernière IP de X-Forwarded-For (Caddy, Nginx… devant le site)
#   vide       → adresse de la connexion (site exposé directement, sans proxy)
TRUST_PROXY=cloudflare

# Tout le reste (nom du site, adresse, e-mail de contact, admins Telegram, villes,
# gares, horaires de bus, textes…) se règle dans la page /admin.
# Pour une ancienne installation, ces variables sont reprises au premier démarrage seulement :
# CONTACT_EMAIL=  SITE_URL=  EDITOR_NAME=  ADMIN_CHAT_IDS=  RECURRING_DAYS=  ARCHIVE_DAYS=
